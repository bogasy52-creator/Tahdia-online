{
  "name": "busraj-games",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "node scripts/verify-worker-config.mjs",
    "test": "node --test test/*.test.js",
    "verify": "npm test && node scripts/verify-static.mjs && npm run check",
