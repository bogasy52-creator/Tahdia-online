{
  "name": "busraj-games",
  "version": "25.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-preview.mjs",
    "deploy": "wrangler deploy",
    "check": "npm run check:cloudflare",
    "test": "node --test --test-concurrency=4 test/*.test.js",
    "verify": "npm run sync:quiz && npm test && npm run verify:static && npm run verify:worker",
    "sync:quiz": "node scripts/sync-quiz-data.mjs",
    "verify:static": "node scripts/verify-static.mjs",
    "verify:worker": "node scripts/verify-worker-offline.mjs",
    "check:cloudflare": "wrangler deploy --dry-run",
    "verify:cloudflare": "npm run verify && npm run check:cloudflare",
    "preverify:release": "node scripts/build-styles.mjs --pages=serpent.html,journey.html,paths-online.html && node scripts/apply-premium.mjs && node scripts/build-offline.mjs",
    "verify:release": "npm run verify && node scripts/verify-v7.mjs",
    "start:local": "node scripts/play-local.mjs",
    "test:browser": "node scripts/test-browser-v7.mjs",
    "test:motion": "node scripts/test-motion-v7.mjs",
    "test:offline": "node scripts/test-offline-v7.mjs",
    "test:cloudflare": "node scripts/verify-cloudflare-runtime.mjs",
    "test:picture": "node scripts/verify-picture-runtime.mjs",
    "test:sudoku": "node scripts/verify-sudoku-runtime.mjs",
    "test:arena": "node scripts/verify-serpent-v23-runtime.mjs",
    "test:paths": "node scripts/verify-paths-v24-runtime.mjs"
  },
  "devDependencies": {
    "wrangler": "4.127.1",
    "esbuild": "0.28.1",
    "miniflare": "5.20260828.0-alpha"
  }
}
